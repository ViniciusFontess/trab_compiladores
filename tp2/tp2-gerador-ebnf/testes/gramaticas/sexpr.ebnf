(* S-expressions no estilo Lisp. Testa: simbolo inicial anulavel
   ({ sexpr }), recursao a direita via "'" sexpr, classe de caracteres
   com escape \/ e com '-' literal no fim, e desempate entre dois
   terminais nomeados (NUM declarado antes de ATOM vence em "-5"). *)
TOKENS
  NUM  = /-?[0-9]+/ ;
  ATOM = /[a-zA-Z_+*\/<>=!?-][a-zA-Z0-9_+*\/<>=!?-]*/ ;
  SKIP = /[ \t\r\n]+/ ;
  SKIP = /;[^\n]*/ ;

RULES
  programa = { sexpr } ;
  sexpr    = ATOM | NUM | "(" { sexpr } ")" | "'" sexpr ;
